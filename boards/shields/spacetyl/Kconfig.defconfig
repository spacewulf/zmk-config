if SHIELD_spacetyl_DONGLE
    config ZMK_KEYBOARD_NAME
        default "spacetyl"

    config ZMK_SPLIT_ROLE_CENTRAL
        default y

    config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
        default 2

    config ZMK_USB
        default y

    config BT_MAX_CONN
        default 7

    config BT_MAX_PAIRED
        default 7
endif

