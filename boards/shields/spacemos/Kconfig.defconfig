if SHIELD_SPACEMOS_DONGLE

config ZMK_KEYBOARD_NAME
  default "spacemos"

config ZMK_SPLIT_ROLE_CENTRAL
  default y

config ZMK_SPLIT_BLE_CENTRAL_PERIPHERALS
  default 2

config BT_MAX_CONN
  default 7

config BT_MAX_PAIRED
  default 7

endif

if SHIELD_SPACEMOS_DONGLE || SHIELD_SPACEMOS_LEFT || SHIELD_SPACEMOS_RIGHT

config ZMK_SPLIT
  default y

endif

