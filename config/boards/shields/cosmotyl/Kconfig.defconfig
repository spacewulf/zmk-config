if SHIELD_cosmotyl_LEFT || SHIELD_cosmotyl_RIGHT || SHIELD_cosmotyl_DONGLE

    config ZMK_SPLIT
        default y

    config ZMK_BLE
        default y

endif # SHIELD_cosmotyl_LEFT || SHIELD_cosmotyl_RIGHT
